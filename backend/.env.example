# Server Port (automatically set by Render / Railway / Heroku / Fly.io)
PORT=8000

# Host binding (0.0.0.0 binds to all network interfaces for containerized/cloud environments)
HOST=0.0.0.0

# Allowed CORS origins (comma-separated or * for open access)
# Examples:
# ALLOWED_ORIGINS=https://my-anatomy-app.vercel.app,https://my-custom-domain.com
ALLOWED_ORIGINS=*

# Database URL
# Defaults to SQLite (backend/anatomy.db).
# For PostgreSQL (e.g. Render / Supabase / Neon / Railway PostgreSQL):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
